{
  "name": "01-mtv",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Combined personal programme viewer for Medeltidsveckan (official + imtv.se)",
  "scripts": {
    "scrape:official": "tsx scripts/scrape-official.ts",
    "scrape:imtv": "tsx scripts/scrape-imtv.ts",
    "merge": "tsx scripts/merge.ts",
    "scrape": "npm run scrape:official && npm run scrape:imtv && npm run merge",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.12",
    "entities": "^8.0.0",
    "solid-js": "^1.9.14",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
