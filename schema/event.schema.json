{
  "$ref": "#/definitions/EventsFile",
  "definitions": {
    "EventsFile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "generatedAt": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "enum": [
                  "official",
                  "imtv"
                ]
              },
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "seriesKey": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "organizer": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "startTime": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              },
              "endTime": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              },
              "venue": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "image": {
                "type": "string",
                "format": "uri"
              },
              "ticketUrl": {
                "type": "string",
                "format": "uri"
              },
              "price": {
                "type": "string"
              },
              "bookingStatus": {
                "type": "string",
                "enum": [
                  "available",
                  "few-left",
                  "soldout"
                ]
              },
              "familyFriendly": {
                "type": "boolean"
              },
              "includedInPass": {
                "type": "boolean"
              },
              "editorTip": {
                "type": "boolean"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lastModified": {
                "type": "string"
              },
              "raw": {}
            },
            "required": [
              "schemaVersion",
              "id",
              "source",
              "sourceId",
              "seriesKey",
              "title",
              "date",
              "startTime"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "generatedAt",
        "events"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
